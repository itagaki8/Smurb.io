<%- include('../partials/head') %>
<body class="bg-[#0f172a] text-slate-200 min-h-screen">
    <%- include('../partials/navBar') %>

    <main class="max-w-7xl mx-auto p-6 md:p-12">
        
        <header class="mb-12 flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
            <div>
                <h2 class="text-4xl font-black text-white tracking-tight">Espace <span class="text-indigo-500">Directeur</span></h2>
                <p class="text-slate-500 uppercase text-[10px] font-bold tracking-[0.2em] mt-2">Dr. <%= directeur.prenom %> <%= directeur.nom %></p>
            </div>
            <div class="flex gap-3">
                <div class="bg-slate-900 border border-slate-800 px-6 py-3 rounded-2xl">
                    <p class="text-slate-500 text-[10px] uppercase font-bold">Mémoires suivis</p>
                    <p class="text-xl font-black text-white"><%= sujets.length %></p>
                </div>
            </div>
        </header>

        <div class="grid grid-cols-1 gap-6">
            <% if (sujets.length > 0) { %>
                <% sujets.forEach(sujet => { %>
                    <div class="bg-slate-900/50 border border-slate-800 rounded-[32px] p-8 hover:border-indigo-500/50 transition-all group">
                        <div class="flex flex-col lg:flex-row justify-between gap-8">
                            
                            <div class="flex-1">
                                <div class="flex items-center gap-3 mb-4">
                                    <span class="bg-indigo-600/10 text-indigo-400 text-[10px] font-black px-3 py-1 rounded-full uppercase">Sujet Attribué</span>
                                    <span class="text-slate-600 text-[10px] font-medium"><%= new Date(sujet.dateSoumission).toLocaleDateString() %></span>
                                </div>
                                <h3 class="text-2xl font-bold text-white mb-3 group-hover:text-indigo-400 transition-colors"><%= sujet.intitule %></h3>
                                <p class="text-slate-400 text-sm leading-relaxed mb-6 line-clamp-2">
                                    <%= sujet.description %>
                                </p>
                                
                                <div class="inline-flex items-center gap-2 bg-slate-800 px-4 py-2 rounded-xl">
                                    <div class="w-2 h-2 rounded-full <%= sujet.scoreSimilarite > 0.5 ? 'bg-orange-500' : 'bg-green-500' %>"></div>
                                    <p class="text-[11px] font-bold text-slate-300">Indice de similarité : <%= (sujet.scoreSimilarite * 100).toFixed(1) %>%</p>
                                </div>
                            </div>

                            <div class="lg:w-72 bg-slate-800/30 border border-slate-800 p-6 rounded-2xl flex flex-col justify-center">
                                <p class="text-[10px] font-bold text-slate-500 uppercase tracking-widest mb-4">Étudiant assigné</p>
                                <div class="flex items-center gap-3">
                                    <div class="w-10 h-10 bg-indigo-600 rounded-full flex items-center justify-center font-black text-white">
                                        <%= sujet.etudiant.nom.charAt(0) %>
                                    </div>
                                    <div>
                                        <p class="text-sm font-bold text-white"><%= sujet.etudiant.nom %></p>
                                        <p class="text-[10px] text-slate-500"><%= sujet.etudiant.email %></p>
                                    </div>
                                </div>
                                <a href="mailto:<%= sujet.etudiant.email %>" class="mt-6 block text-center bg-white text-[#0f172a] text-[10px] font-black py-3 rounded-xl hover:bg-indigo-400 transition-colors uppercase tracking-widest">
                                    Contacter
                                </a>
                            </div>
                            
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <div class="text-center py-20 bg-slate-900/20 border-2 border-dashed border-slate-800 rounded-[32px]">
                    <p class="text-slate-500 italic">Aucun sujet ne vous a été attribué pour le moment.</p>
                </div>
            <% } %>
        </div>
    </main>

    <%- include('../partials/footer') %>
</body>