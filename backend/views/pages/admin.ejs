<%- include('../partials/head') %>
<%- include('../partials/sidebar') %>

<div class="max-w-7xl mx-auto animate__animated animate__fadeIn">
    <div class="flex justify-between items-center mb-12">
        <h2 class="text-4xl font-black text-slate-900 tracking-tight">Console <span class="text-blue-600 underline decoration-4 underline-offset-8">Admin</span></h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <% directeurs.forEach(dir => { %>
            <div class="glass-card rounded-3xl border border-slate-200 overflow-hidden hover-lift shadow-sm">
                <div class="p-6 bg-slate-900 text-white">
                    <h3 class="text-xl font-black mb-1"><%= dir.nom %></h3>
                    <p class="text-blue-400 text-xs font-bold uppercase tracking-tighter"><%= dir.skills %></p>
                </div>
                
                <div class="p-6 bg-white">
                    <p class="text-[10px] font-black text-slate-400 uppercase mb-4 tracking-widest">Sujets Attribués</p>
                    <div class="space-y-2">
                        <% dir.listeSujets.forEach(sujet => { %>
                            <div class="text-sm p-3 rounded-xl bg-slate-50 border border-slate-100 flex justify-between items-center">
                                <span class="font-bold text-slate-700 truncate mr-2"><%= sujet.titre %></span>
                                <span class="text-[9px] bg-slate-200 px-2 py-1 rounded font-black"><%= sujet.nomEtudiant %></span>
                            </div>
                        <% }) %>
                    </div>
                </div>
            </div>
        <% }) %>
    </div>
</div>

<%- include('../partials/footer') %>