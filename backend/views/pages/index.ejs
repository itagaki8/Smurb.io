<%- include('../partials/head') %>

<body class="bg-[#0f172a] text-white min-h-screen flex flex-col items-center justify-center font-sans p-4 md:p-8 relative overflow-hidden">
    
    <div class="absolute top-10 left-1/2 -translate-x-1/2 opacity-20">
        <div class="grid grid-cols-6 gap-2">
            <% for(let i=0; i<12; i++) { %><div class="w-1 h-1 bg-slate-400 rounded-full"></div><% } %>
        </div>
    </div>

    <div class="w-full max-w-4xl flex flex-col items-start justify-center">
        
        <header class="flex items-center gap-2 mb-12 animate__animated animate__fadeInDown">
            <h1 class="text-xl font-black tracking-tighter uppercase italic">
                Smurb<span class="text-indigo-500">.io</span>
            </h1>
        </header>

        <div class="mb-10 animate__animated animate__fadeIn">
            <h2 class="text-6xl font-black tracking-tighter mb-2">Sign-in</h2>
            <p class="text-slate-400 text-lg font-bold">Etes-vous?</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 w-full animate__animated animate__fadeInUp">
            
            <a href="/login" class="group bg-slate-800/30 border border-slate-700/50 rounded-[40px] p-12 flex flex-col items-center justify-center gap-6 hover:bg-indigo-600/40 transition-all duration-300">
                <h3 class="text-3xl font-black tracking-tight">Etudiant</h3>
                <div class="text-white">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-20 w-20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 14l9-5-9-5-9 5 9 5z" />
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" />
                    </svg>
                </div>
            </a>

            <a href="/login" class="group bg-slate-800/30 border border-slate-700/50 rounded-[40px] p-12 flex flex-col items-center justify-center gap-6 hover:bg-indigo-600/40 transition-all duration-300">
                <h3 class="text-3xl font-black tracking-tight">Directeur</h3>
                <div class="text-white">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-20 w-20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M8 14v3m4-3v3m4-3v3M3 21h18M3 10h18M3 7l9-4 9 4M4 10h16v11H4V10z" />
                    </svg>
                </div>
            </a>

        </div>

        <div class="w-full mt-12 flex justify-end">
            <button class="bg-[#d9e396] hover:bg-[#c8d47b] text-[#0f172a] font-bold py-3 px-8 rounded-full text-sm transition-all shadow-lg">
                En savoir plus
            </button>
        </div>

    </div>

    <div class="absolute bottom-8 left-8 opacity-20">
        <div class="flex flex-col gap-1">
            <% for(let i=0; i<6; i++) { %><div class="w-8 h-1 bg-white"></div><% } %>
        </div>
    </div>

    <div class="absolute bottom-8 right-8 opacity-20">
        <div class="grid grid-cols-4 gap-2">
            <% for(let i=0; i<12; i++) { %><div class="w-1 h-1 bg-slate-400 rounded-full"></div><% } %>
        </div>
    </div>

</body>